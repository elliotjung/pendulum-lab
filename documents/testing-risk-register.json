      "sourcePaths": ["src/workers/jobProtocol.ts", "src/workers/JobEngine.ts", "src/runtime/JobClient.ts"],
      "testPaths": ["tests/job-protocol.test.ts"],
      "requiredAssertions": [
        "cancel-during-run stops",
