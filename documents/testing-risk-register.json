{
  "schemaVersion": "pendulum-testing-risk-register/v1",
  "coverageTargets": {
    "lines": 65,
    "statements": 65,
    "branches": 60,
    "functions": 60,
    "policy": "Targets are release-quality objectives, not claims about the current report. Risk-area failure injection takes priority over low-value line filling."
  },
  "riskAreas": [
    {
